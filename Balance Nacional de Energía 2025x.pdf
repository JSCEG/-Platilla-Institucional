      <pdfaSchema:property>
       <rdf:Seq>
        <rdf:li rdf:parseType="Resource">
         <pdfaProperty:name>declarations</pdfaProperty:name>
         <pdfaProperty:valueType>Bag declaration</pdfaProperty:valueType>
         <pdfaProperty:category>external</pdfaProperty:category>
